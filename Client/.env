# ==========================================
# MeshChat Frontend Environment Configuration
# ==========================================

# Server 1: NestJS Backend (Default Port 3000)
EXPO_PUBLIC_SERVER1_API_URL=http://localhost:3000

# Server 2: FastAPI Backend (Default Port 8000)
EXPO_PUBLIC_SERVER2_API_URL=http://localhost:8000
EXPO_PUBLIC_SERVER2_WS_URL=ws://localhost:8000/ws

# Default active server selection ('server1' or 'server2')
EXPO_PUBLIC_DEFAULT_SERVER=server2
